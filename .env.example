# ==============================================================================
# AlphaForge AI - Configuration Environnement (.env.example)
# Datathon 2026 : Banque Nationale × AWS × PolyFinances
# ==============================================================================
# Pour exécuter le projet, copiez ce fichier vers .env :
#   cp .env.example .env
# Puis renseignez vos identifiants AWS ci-dessous.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Identifiants AWS & Région (Obligatoire pour Bedrock, DynamoDB, Cognito, S3)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Renseignez ici vos clés AWS (fournies via Event Engine, Learner Lab ou IAM) :
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Session token requis uniquement si vous utilisez des identifiants temporaires (Event Engine / SSO) :
AWS_SESSION_TOKEN=your-session-token-if-temporary

# Alternative : utiliser un profil configuré localement avec 'aws configure --profile datathon'
# AWS_PROFILE=datathon


# ------------------------------------------------------------------------------
# 2. Modèles de Fondation Amazon Bedrock (LangGraph Multi-Agents)
# ------------------------------------------------------------------------------
# Modèle principal (Raisonnement, Profil client Agent 1, Synthèse explicable Agent 4)
AF_MODEL_MAIN=global.anthropic.claude-sonnet-5-5

# Modèle rapide (Classification rapide des actualités Agent 2, annotations de scénarios)
AF_MODEL_FAST=global.anthropic.claude-haiku-5-5

# Modèle de revue critique (Agent 3 Red Team & arbitrage complexe)
AF_MODEL_REVIEW=global.anthropic.claude-opus-5-5


# ------------------------------------------------------------------------------
# 3. Persistance AWS Cloud (DynamoDB, S3, Checkpoints LangGraph)
# ------------------------------------------------------------------------------
# Backend d'audit et de traçabilité des agents : 'dynamodb' pour stocker les traces dans AWS
AF_TRACE_BACKEND=dynamodb
AF_DYNAMODB_TABLE=alphaforge-traces

# Checkpoints d'état multi-agents (LangGraph) : 'dynamodb' ou 'memory'
AF_CHECKPOINTER=memory
AF_CHECKPOINTS_TABLE=alphaforge-checkpoints

# Gestion des utilisateurs et profils investisseurs
AF_USERS_BACKEND=dynamodb
AF_USERS_TABLE=alphaforge-users

# Seau de données S3
AF_S3_BUCKET=alphaforge-data-908027403910


# ------------------------------------------------------------------------------
# 4. Authentification Amazon Cognito
# ------------------------------------------------------------------------------
# 'on' : Authentification officielle AWS Cognito (Recommandé pour la démonstration Jury)
# 'off' : Mode hors-ligne / développement local avec tokens JWT locaux sans contacter Cognito
AF_AUTH=on
AF_COGNITO_USER_POOL_ID=us-east-1_XjxuVar8b
AF_COGNITO_CLIENT_ID=9lreq61mqkf01s9h9h48gkcfe


# ------------------------------------------------------------------------------
# 5. Données Financières, Macroéconomie & Actualités
# ------------------------------------------------------------------------------
# 'cache' : Utilise les actualités et données pré-enregistrées (Recommandé pour le jury :
#           déterministe, instantané, auto-suffisant, sans clé API payante externe)
# 'live'  : Interroge les API web en temps réel (nécessite les clés optionnelles ci-dessous)
AF_NEWS_MODE=cache
AF_DATA_PROVIDER=csv

# FACULTATIF (Requis UNIQUEMENT si AF_NEWS_MODE=live) :
FINNHUB_API_KEY=
TAVILY_API_KEY=


# ------------------------------------------------------------------------------
# 6. Gouvernance, Garde-fous & Limites d'Exécution
# ------------------------------------------------------------------------------
# Agent 3 Red Team (contrôle contradictoire des biais et risques)
AF_RED_TEAM=on
AF_RED_TEAM_RECHECK=off

# Limites de requêtes pour la protection des coûts
AF_DAILY_RUN_CAP=300
AF_RATE_LIMIT_RUNS=8
AF_MAX_CONCURRENT_RUNS=3
